# Generated by packaging/homebrew/render-formula.sh in the twscrape4j release workflow; do not edit.
class Twscrape < Formula
  desc "Stateless Twitter/X scraping CLI (GraalVM native executable)"
  homepage "https://github.com/andreygrigoriev/twscrape4j"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/andreygrigoriev/twscrape4j/releases/download/v@VERSION@/twscrape-@VERSION@-macos-arm64.tar.gz"
      sha256 "@SHA256_MACOS_ARM64@"
    end
    on_intel do
      url "https://github.com/andreygrigoriev/twscrape4j/releases/download/v@VERSION@/twscrape-@VERSION@-macos-x86_64.tar.gz"
      sha256 "@SHA256_MACOS_X86_64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/andreygrigoriev/twscrape4j/releases/download/v@VERSION@/twscrape-@VERSION@-linux-arm64.tar.gz"
      sha256 "@SHA256_LINUX_ARM64@"
    end
    on_intel do
      url "https://github.com/andreygrigoriev/twscrape4j/releases/download/v@VERSION@/twscrape-@VERSION@-linux-x86_64.tar.gz"
      sha256 "@SHA256_LINUX_X86_64@"
    end
  end

  def install
    bin.install "twscrape"
  end

  test do
    assert_match "twscrape #{version}", shell_output("#{bin}/twscrape --version")
    # no credentials in the environment -> configuration error, exit code 3
    output = shell_output("env -i #{bin}/twscrape search foo 2>&1", 3)
    assert_match "TWSCRAPE_AUTH_TOKEN", output
  end
end
